				Random Value In Array(Array(Array(3, 7), Array(3, 8), Array(3, 10), Array(6, 10), Array(7, 8), Array(7, 10), Array(10, 11))),
				Random Value In Array(Array(Array(0, 2), Array(0, 4), Array(0, 11), Array(1, 3), Array(1, 6), Array(1, 9), Array(3, 9))),
				Random Value In Array(Array(Array(3, 7), Array(3, 8), Array(3, 10), Array(6, 10), Array(7, 8), Array(7, 10), Array(10, 11))),
				Random Value In Array(Array(Array(0, 2, 4), Array(1, 3, 6), Array(1, 3, 9), Array(3, 7, 8), Array(3, 7, 10), Array(6, 10, 11), Array(7, 8, 10)))),
			Array(
