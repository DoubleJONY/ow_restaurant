				"{0}{1}\r\n{2}", Hero Icon String(Hero Of(All Players(Team 1)[False])), Global.permissionText[False][All Players(Team 1)
				[False].permission], All Players(Team 1)[False]), Custom String("개인 총 수입 : 〔{0}〕\r\n개인 활약 점수 : 〔{1}〕\r\n요리에 기여함 : 〔{2}〕", All Players(Team 1)[False].scbDollar, All Players(Team 1)[False].scbScore,
