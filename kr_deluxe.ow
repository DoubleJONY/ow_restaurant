				Array(9, 1), Array(11, 10), Array(9, 3), Array(7, 10), Array(6, 11), Array(8, 10), Array(0, 2),
				Array(3, 1, 9),
				Array(6, 10, 11),
				Array(2, 0, 4)
			)
		)[Global.stageMode[1]];
	}
}

