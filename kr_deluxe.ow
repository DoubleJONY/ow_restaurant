				Global.currentCustomer = Array(Hero(Zarya), Hero(Bastion));
				Global.hintText = Array(
					Custom String("푸드 파이터는 3개의 음식을 서빙해야 합니다.")
				);
			Else If(Global.stage == 6);
				Global.currentCustomer = Array(Hero(Hanzo), Hero(Mercy));
				Global.hintText = Array(
